{
  "name": "devpilot",
  "displayName": "DevPilot",
  "description": "An AI-Powered VS Code Extension for Beginners",
  "version": "0.0.1",
  "publisher": "hooriaamir",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:devpilot.helloWorld",
    "onCommand:devpilot.openDashboard",
    "onCommand:devpilot.setOpenAIKey"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devpilot.helloWorld",
        "title": "DevPilot: Hello World"
      },
      {
        "command": "devpilot.openDashboard",
        "title": "DevPilot: Open Dashboard"
      },
      {
        "command": "devpilot.setOpenAIKey",
        "title": "DevPilot: Set OpenAI Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devpilot",
          "title": "DevPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "devpilot": [
        {
          "id": "devpilot.dashboard",
          "name": "Dashboard"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",

    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",

    "check-types": "tsc --noEmit",
    "lint": "eslint src",

    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test"
  },
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.441.0",
    "next-themes": "^0.4.6",
    "openai": "^5.23.2",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.63.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.2.1",
    "simple-git": "^3.28.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  }
}


